<Window x:Class="Group1_Login.View.InputProfile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Group1_Login.View"
        mc:Ignorable="d"
        Title="InputProfile" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1C352D"
        xmlns:vm="clr-namespace:Group1_Login.ViewModel">

    <Window.DataContext>
        <vm:InputProfileViewModel/>
    </Window.DataContext>

    <Grid>
        
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1C352D" Offset="0"/>
                <GradientStop Color="#27473B" Offset="0.5"/>
                <GradientStop Color="#315C4C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
       
        <Border Width="420"
                Padding="20"
                Height="430"
                CornerRadius="10"
                Background="#FFF9E5"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>


                <TextBlock Text="Edit Profile"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"      
                   Foreground="#1C352D"/>


                <TextBlock Text="FirstName"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#1C352D"
                    Margin="10,10,0,5"/>
                <Border CornerRadius="5"
                    Width="370"
                    Background="White"
                    BorderBrush="#1C352D"
                    BorderThickness="1">
                <TextBox x:Name="FirstName_txt"
                     Height="25"
                     FontSize="11"
                     Padding="5"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#1E201E"
                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <TextBlock Text="Middle Name"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#1C352D"
                     Margin="10,10,0,5"/>
                <Border CornerRadius="5"
                     Width="370"
                     Background="White"
                     BorderBrush="#1C352D"
                     BorderThickness="1">
                    <TextBox x:Name="MiddleName_txt"
                     Height="25"
                     FontSize="11"  
                     Padding="5"
                     BorderThickness="0"    
                     Background="Transparent"
                     Foreground="#1E201E"
                     Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <TextBlock Text="Last Name"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#1C352D"
                     Margin="10,10,0,5"/>
                <Border CornerRadius="5"
                     Width="370"
                     Background="White"
                     BorderBrush="#1C352D"
                     BorderThickness="1">
                <TextBox x:Name="LastName_txt"
                     Height="25"
                     FontSize="11"
                     Padding="5"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#1E201E"
                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <TextBlock Text="Address"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#1C352D"
                     Margin="10,10,0,5"/>
                <Border CornerRadius="5"
                     Width="370"
                     Background="White"
                     BorderBrush="#1C352D"
                     BorderThickness="1">
               <TextBox x:Name="Address_txt"
                    Height="25"
                    FontSize="11"
                    Padding="5"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#1E201E"
                    Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>   
                </Border>


                <TextBlock Text="Religion"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#1C352D"
                     Margin="10,10,0,5"/>
                <Border CornerRadius="5"
                    Width="370"
                    Background="White"
                    BorderBrush="#1C352D"
                    BorderThickness="1">
                <TextBox x:Name="Religion_txt"
                    Height="25"
                    FontSize="11"
                    Padding="5"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#1E201E"
                    Text="{Binding Religion, UpdateSourceTrigger=PropertyChanged}"/>      
                </Border>
               
                <Button x:Name="Submit_btn"
                    Content="Submit"
                    Height="30"
                    Width="100"
                    Margin="0,20,0,0"
                    FontWeight="Bold"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding SubmitCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">

                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#11998E" Offset="0"/>
                            <GradientStop Color="#38EF7D" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </StackPanel>
        </Border>

    </Grid>
        
    
</Window>
