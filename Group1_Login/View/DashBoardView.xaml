<Window x:Class="Group1_Login.View.DashBoardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F2027">

    <Grid>

      
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1C352D" Offset="0"/>
                <GradientStop Color="#27473B" Offset="0.5"/>
                <GradientStop Color="#315C4C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

      
        <Border Width="500"
                Height="350"
                CornerRadius="20"
                Padding="50"
                Background="#FFF9E5"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.5"
                                  Color="#000000"/>
            </Border.Effect>

            <StackPanel>

            
                <TextBlock Text="Welcome!👋"
                           FontSize="35"
                           FontWeight="Bold"
                           Foreground="#2C5364"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Select what you'd like to do"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <UniformGrid Columns="2" HorizontalAlignment="Center">

                   
                    <Button Height="50"
                            Width="100"
                            Margin="10"
                            Command="{Binding ProfileCommand}"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            FontSize="16"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#11998E" Offset="0"/>
                                <GradientStop Color="#114232" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👤"
                                       FontSize="15"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Profile"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    
                    <Button Height="50"
                            Margin="10"
                            Command="{Binding CameraCommand}"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            FontSize="16"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#11998E" Offset="0"/>
                                <GradientStop Color="#FF3C8658" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📷"
                                       FontSize="15"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Camera"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>

            </StackPanel>

        </Border>
    </Grid>
</Window>