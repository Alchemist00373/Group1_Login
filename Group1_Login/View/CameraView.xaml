<Window x:Class="Group1_Login.View.CameraView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Dashboard"
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1C352D" Offset="0"/>
                <GradientStop Color="#27473B" Offset="0.5"/>
                <GradientStop Color="#315C4C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>



        <Grid Height="50"
              Background="#000000"
              VerticalAlignment="Top">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button Grid.Column="0"
                    Content="← Back"
                    Margin="10"
                    Width="70"
                    Height="30"
                    VerticalAlignment="Center"
                    Command="{Binding BackCommand}">

                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#11998E" Offset="0"/>
                        <GradientStop Color="#38EF7D" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                  CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>


            <TextBlock Grid.Column="1"
                       Text="Camera"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Grid>


        <Border Margin="20,70,20,20"
                    Background="Black"
                    CornerRadius="8"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1">

            <Image Source="{Binding CameraImage}" Stretch="Uniform"/>


        </Border>

    </Grid>
</Window>