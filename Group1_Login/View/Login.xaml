<Window x:Class="Group1_Login.View.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1C352D"
        xmlns:vm="clr-namespace:Group1_Login.ViewModel">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>


        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1C352D" Offset="0"/>
                <GradientStop Color="#27473B" Offset="0.5"/>
                <GradientStop Color="#315C4C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Border Width="420"
                Height="430"
                Padding="40"
                CornerRadius="20"
                Background="#FFF9E5"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>


              <Grid Width="100" 
                   Height="100" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,0">

              <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10s10-4.48 10-10S17.52 2 12 2m0 4c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6m0 14c-2.03 0-4.43-.82-6.14-2.88a9.95 9.95 0 0 1 12.28 0C16.43 19.18 14.03 20 12 20" 
                  Width="100"
                  Height="100"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                        <Path.Fill>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#11998E"/>
                                <GradientStop Color="#38EF7D" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Grid>



                <TextBlock Text="Username"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1C352D"
                           Margin="0,10,0,5"/>

                <Border  Background="Transparent"
                           BorderBrush="#1C352D"
                           BorderThickness="0,0,0,1">
                    <TextBox x:Name="UserName_txt"
                           Height="40"
                           FontSize="14"
                           Padding="10"
                           BorderThickness="0"
                           Background="Transparent"
                           Foreground="#1E201E"
                           Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>


                <TextBlock Text="Password"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1C352D"
                           Margin="0,20,0,5"/>

                <Border  Background="Transparent"
                         BorderBrush="#1C352D"
                         BorderThickness="0,0,0,1">
                    <PasswordBox x:Name="Password_txt"
                           Height="40"
                           FontSize="14"
                           Padding="10"
                           BorderThickness="0"
                           Background="Transparent"
                           Foreground="#1E201E"/>
                </Border>


                <Button x:Name="Login_btn"
                        Content="LOGIN"
                        Height="45"
                        Width="150"
                        Margin="0,40,0,0"
                        FontWeight="Bold"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=Password_txt}">


                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#11998E" Offset="0"/>
                            <GradientStop Color="#38EF7D" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </StackPanel>
        </Border>

    </Grid>
</Window>
