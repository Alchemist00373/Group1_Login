<Window x:Class="Group1_Login.View.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Group1_Login.View"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid Background="#1C352D">
        <Label Content="VICTORIA" HorizontalAlignment="Center" Margin="0, 62, 0, 0" FontSize="60" FontWeight="Bold" FontFamily="Arial" Foreground="#FFF9E5" />

        <StackPanel  Margin="136,142,136,52">
            <TextBlock Text="Username:" FontSize="16" Margin="0, 20, 0, 5" Foreground="#FFF9E5" />
            <TextBox x:Name="UserName_txt" Height="30" FontSize="14"  Width="441" Opacity="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Foreground="#1E201E" />
            <TextBlock Text="Password:" FontSize="16" Margin="0, 20, 0, 5" Foreground="#FFF9E5"/>
            <PasswordBox x:Name="Password_txt" Height="30" FontSize="14" Width="441" Opacity="1" Foreground="#1E201E"  />
            <Button Name="Login_btn" Content="Login" Margin=" 30" Height="40" Width="100" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=Password_txt}"/>
        </StackPanel>
    </Grid>
</Window>
